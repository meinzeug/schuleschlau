[Unit]
Description=Remove unreferenced old SCHULPILOT restore runtimes
ConditionPathIsDirectory=/opt/schulpilot/restore-runtimes

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/schulpilot/current/deploy/prune_restore_runtimes.py --apply
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/schulpilot /run/lock
TimeoutStartSec=15min
