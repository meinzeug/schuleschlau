[Unit]
Description=SCHULPILOT encrypted offsite backup pull
After=network-online.target

[Service]
Type=oneshot
UMask=0077
ExecStart=/usr/bin/python3 %h/schulpilot/scripts/offsite_backup.py
# Include the bounded one-minute success pacing; the transfer retains 10 minutes.
TimeoutStartSec=11min
NoNewPrivileges=true
PrivateTmp=true
